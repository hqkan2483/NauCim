generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id           String  @id
  name         String
  description  String?
  version      String
  createDate   String
  modifyDate   String
  accessRights String?

  models   Model[]
  profiles Profile[]
}

model Model {
  id           String  @id
  projectId    String
  name         String
  description  String?
  type         String?
  version      String
  createDate   String
  modifyDate   String
  legalState   String?
  legalAct     String?
  accessRights String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  packages            PackageModel[]
  classes             ClassModel[]
  attributes          AttributeModel[]
  literals            LiteralModel[]
  diagrams            DiagramModel[]
  generalizationLinks GeneralizationLinkModel[]
  associationLinks    AssociationLinkModel[]

  relatedProfiles Profile[] @relation("ModelProfiles")

  @@index([projectId])
  @@index([name])
}

model Profile {
  id           String  @id
  projectId    String
  name         String
  description  String?
  version      String
  createDate   String
  modifyDate   String
  legalState   String?
  legalAct     String?
  accessRights String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  packages            PackageProfile[]
  classes             ClassProfile[]
  attributes          AttributeProfile[]
  literals            LiteralProfile[]
  diagrams            DiagramProfile[]
  generalizationLinks GeneralizationLinkProfile[]
  associationLinks    AssociationLinkProfile[]

  relatedModels Model[] @relation("ModelProfiles")

  @@index([projectId])
  @@index([name])
}

// ===== PACKAGE =====

model PackageModel {
  id       String  @id
  srcId    String?
  modelId  String
  parentId String?

  name            String
  type            String?
  parentPackage   String?
  documentation   String?
  documentationRu String?
  details         String?

  model  Model         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  parent PackageModel? @relation("PackageModelTree", fields: [parentId, modelId], references: [id, modelId], onDelete: Cascade)

  subPackages PackageModel[] @relation("PackageModelTree")
  classes     ClassModel[]
  diagrams    DiagramModel[]

  @@unique([id, modelId])
  @@index([modelId])
  @@index([parentId, modelId])
  @@index([name])
}

model PackageProfile {
  id        String  @id
  srcId     String?
  profileId String
  parentId  String?

  name            String
  type            String?
  parentPackage   String?
  documentation   String?
  documentationRu String?
  details         String?

  profile Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  parent  PackageProfile? @relation("PackageProfileTree", fields: [parentId, profileId], references: [id, profileId], onDelete: Cascade)

  subPackages PackageProfile[] @relation("PackageProfileTree")
  classes     ClassProfile[]
  diagrams    DiagramProfile[]

  @@unique([id, profileId])
  @@index([profileId])
  @@index([parentId, profileId])
  @@index([name])
}

// ===== DIAGRAM =====

model DiagramModel {
  id        String  @id
  srcId     String?
  modelId   String
  packageId String

  diagramType   String?
  diagramName   String
  documentation String?
  details       String?
  diagramBody   String?

  model Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  pkg   PackageModel @relation(fields: [packageId, modelId], references: [id, modelId], onDelete: Cascade)

  @@index([modelId])
  @@index([packageId, modelId])
  @@index([diagramName])
}

model DiagramProfile {
  id        String  @id
  srcId     String?
  profileId String
  packageId String

  diagramType   String?
  diagramName   String
  documentation String?
  details       String?
  diagramBody   String?

  profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pkg     PackageProfile @relation(fields: [packageId, profileId], references: [id, profileId], onDelete: Cascade)

  @@index([profileId])
  @@index([packageId, profileId])
  @@index([diagramName])
}

// ===== CLASS =====

model ClassModel {
  id        String  @id
  srcId     String?
  modelId   String
  packageId String

  name            String
  type            String?
  stereotype      String?
  documentation   String?
  documentationRu String?
  details         String?
  isAbstract      Boolean?

  refModelId     String?
  refModelItemId String?

  model Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  pkg   PackageModel @relation(fields: [packageId, modelId], references: [id, modelId], onDelete: Cascade)

  attributes            AttributeModel[] @relation("AttributeModelOwner")
  dataTypeForAttributes AttributeModel[] @relation("AttributeModelDataType")
  literals              LiteralModel[]

  @@unique([id, modelId])
  @@index([modelId])
  @@index([packageId, modelId])
  @@index([name])
}

model ClassProfile {
  id        String  @id
  srcId     String?
  profileId String
  packageId String

  name            String
  type            String?
  stereotype      String?
  documentation   String?
  documentationRu String?
  details         String?
  isAbstract      Boolean?

  refModelId     String?
  refModelItemId String?

  profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pkg     PackageProfile @relation(fields: [packageId, profileId], references: [id, profileId], onDelete: Cascade)

  attributes            AttributeProfile[] @relation("AttributeProfileOwner")
  dataTypeForAttributes AttributeProfile[] @relation("AttributeProfileDataType")
  literals              LiteralProfile[]

  @@unique([id, profileId])
  @@index([profileId])
  @@index([packageId, profileId])
  @@index([name])
}

// ===== ATTRIBUTE =====

model AttributeModel {
  id      String  @id
  srcId   String?
  modelId String
  classId String

  name            String
  dataTypeId      String?
  stereotype      String?
  multiplicity    String?
  documentation   String?
  documentationRu String?
  details         String?

  initialValue String?

  refModelId     String?
  refModelItemId String?

  model    Model       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  cls      ClassModel  @relation("AttributeModelOwner", fields: [classId, modelId], references: [id, modelId], onDelete: Cascade)
  dataType ClassModel? @relation("AttributeModelDataType", fields: [dataTypeId, modelId], references: [id, modelId])

  @@index([modelId])
  @@index([classId, modelId])
  @@index([dataTypeId, modelId])
  @@index([name])
}

model AttributeProfile {
  id        String  @id
  srcId     String?
  profileId String
  classId   String

  name            String
  dataTypeId      String?
  stereotype      String?
  multiplicity    String?
  documentation   String?
  documentationRu String?
  details         String?

  initialValue String?

  refModelId     String?
  refModelItemId String?

  profile  Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cls      ClassProfile  @relation("AttributeProfileOwner", fields: [classId, profileId], references: [id, profileId], onDelete: Cascade)
  dataType ClassProfile? @relation("AttributeProfileDataType", fields: [dataTypeId, profileId], references: [id, profileId])

  @@index([profileId])
  @@index([classId, profileId])
  @@index([dataTypeId, profileId])
  @@index([name])
}

// ===== LITERAL =====

model LiteralModel {
  id      String  @id
  srcId   String?
  modelId String
  classId String

  name            String
  value           String?
  documentation   String?
  documentationRu String?

  model Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  cls   ClassModel @relation(fields: [classId, modelId], references: [id, modelId], onDelete: Cascade)

  @@index([modelId])
  @@index([classId, modelId])
  @@index([name])
}

model LiteralProfile {
  id        String  @id
  srcId     String?
  profileId String
  classId   String

  name            String
  value           String?
  documentation   String?
  documentationRu String?

  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cls     ClassProfile @relation(fields: [classId, profileId], references: [id, profileId], onDelete: Cascade)

  @@index([profileId])
  @@index([classId, profileId])
  @@index([name])
}

// ===== GENERALIZATION LINK =====

model GeneralizationLinkModel {
  id      String  @id
  srcId   String?
  modelId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  model Model                         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  ends  GeneralizationClassRefModel[]

  @@unique([id, modelId])
  @@index([modelId])
}

model GeneralizationLinkProfile {
  id        String  @id
  srcId     String?
  profileId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  profile Profile                         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ends    GeneralizationClassRefProfile[]

  @@unique([id, profileId])
  @@index([profileId])
}

model GeneralizationClassRefModel {
  id String @id @default(cuid())

  generalizationLinkId String
  modelId              String
  role                 String

  classId   String
  className String

  generalizationLink GeneralizationLinkModel @relation(fields: [generalizationLinkId, modelId], references: [id, modelId], onDelete: Cascade)

  @@unique([generalizationLinkId, modelId, role])
  @@index([generalizationLinkId, modelId])
  @@index([classId])
}

model GeneralizationClassRefProfile {
  id String @id @default(cuid())

  generalizationLinkId String
  profileId            String
  role                 String

  classId   String
  className String

  generalizationLink GeneralizationLinkProfile @relation(fields: [generalizationLinkId, profileId], references: [id, profileId], onDelete: Cascade)

  @@unique([generalizationLinkId, profileId, role])
  @@index([generalizationLinkId, profileId])
  @@index([classId])
}

// ===== ASSOCIATION LINK =====

model AssociationLinkModel {
  id      String  @id
  srcId   String?
  modelId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  model   Model                     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  linkEnd AssociationLinkEndModel[]

  @@unique([id, modelId])
  @@index([modelId])
}

model AssociationLinkProfile {
  id        String  @id
  srcId     String?
  profileId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  profile Profile                     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  linkEnd AssociationLinkEndProfile[]

  @@unique([id, profileId])
  @@index([profileId])
}

model AssociationLinkEndModel {
  linkEndId String  @id
  srcId     String?

  associationLinkId String
  modelId           String

  linkEndName      String
  linkEndClassId   String
  linkEndClassName String
  multiplicity     String  @default("")
  documentation    String?
  documentationRu  String?
  details          String?
  stereotype       String  @default("")

  associationLink AssociationLinkModel @relation(fields: [associationLinkId, modelId], references: [id, modelId], onDelete: Cascade)

  @@index([associationLinkId, modelId])
  @@index([linkEndClassId])
}

model AssociationLinkEndProfile {
  linkEndId String  @id
  srcId     String?

  associationLinkId String
  profileId         String

  linkEndName      String
  linkEndClassId   String
  linkEndClassName String
  multiplicity     String  @default("")
  documentation    String?
  documentationRu  String?
  details          String?
  stereotype       String  @default("")

  associationLink AssociationLinkProfile @relation(fields: [associationLinkId, profileId], references: [id, profileId], onDelete: Cascade)

  @@index([associationLinkId, profileId])
  @@index([linkEndClassId])
}
