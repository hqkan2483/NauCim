generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id           String  @id
  name         String
  description  String?
  version      String
  createDate   String
  modifyDate   String
  accessRights String?

  models   Model[]
  profiles Profile[]
}

model Model {
  id           String  @id
  projectId    String
  name         String
  description  String?
  type         String?
  version      String
  createDate   String
  modifyDate   String
  legalState   String?
  legalAct     String?
  accessRights String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rootPackages RootPackage[]

  relatedProfiles Profile[] @relation("ModelProfiles")

  @@index([projectId])
  @@index([name])
}

model Profile {
  id           String  @id
  projectId    String
  name         String
  description  String?
  version      String
  createDate   String
  modifyDate   String
  legalState   String?
  legalAct     String?
  accessRights String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rootPackages RootPackage[]

  relatedModels Model[] @relation("ModelProfiles")

  @@index([projectId])
  @@index([name])
}

model RootPackage {
  id String @id @default(cuid())

  modelId   String?
  profileId String?

  model   Model?   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  packages Package[]

  generalizationsList GeneralizationLink[]
  associationList     AssociationLink[]

  @@index([modelId])
  @@index([profileId])
}

model Package {
  id            String  @id
  rootPackageId String
  parentId      String?

  name            String
  type            String?
  parentPackage   String?
  documentation   String?
  documentationRu String?
  details         String?
  modelId         String?
  profileId       String?

  rootPackage RootPackage @relation(fields: [rootPackageId], references: [id], onDelete: Cascade)
  parent      Package?    @relation("PackageTree", fields: [parentId], references: [id], onDelete: Cascade)
  subPackages Package[]   @relation("PackageTree")

  classes Class[]

  @@index([rootPackageId])
  @@index([parentId])
  @@index([name])
}

model Class {
  id        String @id
  packageId String

  name            String
  type            String?
  stereotype      String?
  documentation   String?
  documentationRu String?
  details         String?
  isAbstract      Boolean?

  modelId        String?
  profileId      String?
  refModelId     String?
  refModelItemId String?

  pkg Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  attributes Attribute[]
  links      Link[]
  literals   Literal[]

  @@index([packageId])
  @@index([name])
}

model Attribute {
  id      String @id
  classId String

  name            String
  type            String?
  multiplicity    String?
  documentation   String?
  documentationRu String?
  details         String?

  modelId        String?
  profileId      String?
  refModelId     String?
  refModelItemId String?

  cls Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([name])
}

model Link {
  id      String @id
  classId String

  name            String?
  type            String?
  multiplicity    String?
  documentation   String?
  documentationRu String?
  details         String?

  modelId        String?
  profileId      String?
  refModelId     String?
  refModelItemId String?

  cls Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model Literal {
  id      String @id
  classId String

  name            String
  value           String?
  documentation   String?
  documentationRu String?

  cls Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([name])
}

model GeneralizationLink {
  linkId        String @id
  rootPackageId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  rootPackage RootPackage @relation(fields: [rootPackageId], references: [id], onDelete: Cascade)

  ends GeneralizationClassRef[]

  @@index([rootPackageId])
}

model GeneralizationClassRef {
  id String @id @default(cuid())

  generalizationLinkId String
  role                 String

  classId   String
  className String

  generalizationLink GeneralizationLink @relation(fields: [generalizationLinkId], references: [linkId], onDelete: Cascade)

  @@unique([generalizationLinkId, role])
  @@index([generalizationLinkId])
  @@index([classId])
}

model AssociationLink {
  linkId        String @id
  rootPackageId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  rootPackage RootPackage          @relation(fields: [rootPackageId], references: [id], onDelete: Cascade)
  linkEnd     AssociationLinkEnd[]

  @@index([rootPackageId])
}

model AssociationLinkEnd {
  linkEndId String @id

  associationLinkId String

  linkEndName      String
  linkEndClassId   String
  linkEndClassName String
  multiplicity     String  @default("")
  documentation    String?
  documentationRu  String?
  details          String?
  stereotype       String  @default("")

  associationLink AssociationLink @relation(fields: [associationLinkId], references: [linkId], onDelete: Cascade)

  @@index([associationLinkId])
  @@index([linkEndClassId])
}
