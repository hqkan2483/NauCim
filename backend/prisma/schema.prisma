generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id           String  @id
  name         String
  description  String?
  version      String
  createDate   String
  modifyDate   String
  accessRights String?

  models   Model[]
  profiles Profile[]
}

model Model {
  id           String  @id
  projectId    String
  name         String
  description  String?
  type         String?
  version      String
  createDate   String
  modifyDate   String
  legalState   String?
  legalAct     String?
  accessRights String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  packages            PackageModel[]
  classes             ClassModel[]
  attributes          AttributeModel[]
  links               LinkModel[]
  literals            LiteralModel[]
  generalizationLinks GeneralizationLinkModel[]
  associationLinks    AssociationLinkModel[]

  relatedProfiles Profile[] @relation("ModelProfiles")

  @@index([projectId])
  @@index([name])
}

model Profile {
  id           String  @id
  projectId    String
  name         String
  description  String?
  version      String
  createDate   String
  modifyDate   String
  legalState   String?
  legalAct     String?
  accessRights String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  packages            PackageProfile[]
  classes             ClassProfile[]
  attributes          AttributeProfile[]
  links               LinkProfile[]
  literals            LiteralProfile[]
  generalizationLinks GeneralizationLinkProfile[]
  associationLinks    AssociationLinkProfile[]

  relatedModels Model[] @relation("ModelProfiles")

  @@index([projectId])
  @@index([name])
}

// ===== PACKAGE =====

model PackageModel {
  id      String
  modelId String
  parentId String?

  name            String
  type            String?
  parentPackage   String?
  documentation   String?
  documentationRu String?
  details         String?

  model  Model         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  parent PackageModel? @relation("PackageModelTree", fields: [parentId, modelId], references: [id, modelId], onDelete: Cascade)

  subPackages PackageModel[] @relation("PackageModelTree")
  classes     ClassModel[]

  @@id([id, modelId])
  @@index([modelId])
  @@index([parentId, modelId])
  @@index([name])
}

model PackageProfile {
  id        String
  profileId String
  parentId  String?

  name            String
  type            String?
  parentPackage   String?
  documentation   String?
  documentationRu String?
  details         String?

  profile Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  parent  PackageProfile? @relation("PackageProfileTree", fields: [parentId, profileId], references: [id, profileId], onDelete: Cascade)

  subPackages PackageProfile[] @relation("PackageProfileTree")
  classes     ClassProfile[]

  @@id([id, profileId])
  @@index([profileId])
  @@index([parentId, profileId])
  @@index([name])
}

// ===== CLASS =====

model ClassModel {
  id        String
  modelId   String
  packageId String

  name            String
  type            String?
  stereotype      String?
  documentation   String?
  documentationRu String?
  details         String?
  isAbstract      Boolean?

  refModelId     String?
  refModelItemId String?

  model   Model         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  pkg     PackageModel @relation(fields: [packageId, modelId], references: [id, modelId], onDelete: Cascade)

  attributes AttributeModel[]
  links      LinkModel[]
  literals   LiteralModel[]

  @@id([id, modelId])
  @@index([modelId])
  @@index([packageId, modelId])
  @@index([name])
}

model ClassProfile {
  id        String
  profileId String
  packageId String

  name            String
  type            String?
  stereotype      String?
  documentation   String?
  documentationRu String?
  details         String?
  isAbstract      Boolean?

  refModelId     String?
  refModelItemId String?

  profile Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pkg     PackageProfile @relation(fields: [packageId, profileId], references: [id, profileId], onDelete: Cascade)

  attributes AttributeProfile[]
  links      LinkProfile[]
  literals   LiteralProfile[]

  @@id([id, profileId])
  @@index([profileId])
  @@index([packageId, profileId])
  @@index([name])
}

// ===== ATTRIBUTE =====

model AttributeModel {
  id      String
  modelId String
  classId String

  name            String
  type            String?
  multiplicity    String?
  documentation   String?
  documentationRu String?
  details         String?

  refModelId     String?
  refModelItemId String?

  model Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  cls   ClassModel @relation(fields: [classId, modelId], references: [id, modelId], onDelete: Cascade)

  @@id([id, modelId])
  @@index([modelId])
  @@index([classId, modelId])
  @@index([name])
}

model AttributeProfile {
  id        String
  profileId String
  classId   String

  name            String
  type            String?
  multiplicity    String?
  documentation   String?
  documentationRu String?
  details         String?

  refModelId     String?
  refModelItemId String?

  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cls     ClassProfile @relation(fields: [classId, profileId], references: [id, profileId], onDelete: Cascade)

  @@id([id, profileId])
  @@index([profileId])
  @@index([classId, profileId])
  @@index([name])
}

// ===== LINK =====

model LinkModel {
  id      String
  modelId String
  classId String

  name            String?
  type            String?
  multiplicity    String?
  documentation   String?
  documentationRu String?
  details         String?

  refModelId     String?
  refModelItemId String?

  model Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  cls   ClassModel @relation(fields: [classId, modelId], references: [id, modelId], onDelete: Cascade)

  @@id([id, modelId])
  @@index([modelId])
  @@index([classId, modelId])
}

model LinkProfile {
  id        String
  profileId String
  classId   String

  name            String?
  type            String?
  multiplicity    String?
  documentation   String?
  documentationRu String?
  details         String?

  refModelId     String?
  refModelItemId String?

  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cls     ClassProfile @relation(fields: [classId, profileId], references: [id, profileId], onDelete: Cascade)

  @@id([id, profileId])
  @@index([profileId])
  @@index([classId, profileId])
}

// ===== LITERAL =====

model LiteralModel {
  id      String
  modelId String
  classId String

  name            String
  value           String?
  documentation   String?
  documentationRu String?

  model Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  cls   ClassModel @relation(fields: [classId, modelId], references: [id, modelId], onDelete: Cascade)

  @@id([id, modelId])
  @@index([modelId])
  @@index([classId, modelId])
  @@index([name])
}

model LiteralProfile {
  id        String
  profileId String
  classId   String

  name            String
  value           String?
  documentation   String?
  documentationRu String?

  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cls     ClassProfile @relation(fields: [classId, profileId], references: [id, profileId], onDelete: Cascade)

  @@id([id, profileId])
  @@index([profileId])
  @@index([classId, profileId])
  @@index([name])
}

// ===== GENERALIZATION LINK =====

model GeneralizationLinkModel {
  linkId  String
  modelId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  model Model                           @relation(fields: [modelId], references: [id], onDelete: Cascade)
  ends  GeneralizationClassRefModel[]

  @@id([linkId, modelId])
  @@index([modelId])
}

model GeneralizationLinkProfile {
  linkId    String
  profileId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  profile Profile                           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ends    GeneralizationClassRefProfile[]

  @@id([linkId, profileId])
  @@index([profileId])
}

model GeneralizationClassRefModel {
  id String @id @default(cuid())

  generalizationLinkId String
  modelId              String
  role                 String

  classId   String
  className String

  generalizationLink GeneralizationLinkModel @relation(fields: [generalizationLinkId, modelId], references: [linkId, modelId], onDelete: Cascade)

  @@unique([generalizationLinkId, modelId, role])
  @@index([generalizationLinkId, modelId])
  @@index([classId])
}

model GeneralizationClassRefProfile {
  id String @id @default(cuid())

  generalizationLinkId String
  profileId            String
  role                 String

  classId   String
  className String

  generalizationLink GeneralizationLinkProfile @relation(fields: [generalizationLinkId, profileId], references: [linkId, profileId], onDelete: Cascade)

  @@unique([generalizationLinkId, profileId, role])
  @@index([generalizationLinkId, profileId])
  @@index([classId])
}

// ===== ASSOCIATION LINK =====

model AssociationLinkModel {
  linkId  String
  modelId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  model   Model                        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  linkEnd AssociationLinkEndModel[]

  @@id([linkId, modelId])
  @@index([modelId])
}

model AssociationLinkProfile {
  linkId    String
  profileId String

  linkType        String
  documentation   String?
  documentationRu String?
  details         String?
  stereotype      String  @default("")

  profile Profile                        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  linkEnd AssociationLinkEndProfile[]

  @@id([linkId, profileId])
  @@index([profileId])
}

model AssociationLinkEndModel {
  linkEndId String @id

  associationLinkId String
  modelId           String

  linkEndName      String
  linkEndClassId   String
  linkEndClassName String
  multiplicity     String  @default("")
  documentation    String?
  documentationRu  String?
  details          String?
  stereotype       String  @default("")

  associationLink AssociationLinkModel @relation(fields: [associationLinkId, modelId], references: [linkId, modelId], onDelete: Cascade)

  @@index([associationLinkId, modelId])
  @@index([linkEndClassId])
}

model AssociationLinkEndProfile {
  linkEndId String @id

  associationLinkId String
  profileId         String

  linkEndName      String
  linkEndClassId   String
  linkEndClassName String
  multiplicity     String  @default("")
  documentation    String?
  documentationRu  String?
  details          String?
  stereotype       String  @default("")

  associationLink AssociationLinkProfile @relation(fields: [associationLinkId, profileId], references: [linkId, profileId], onDelete: Cascade)

  @@index([associationLinkId, profileId])
  @@index([linkEndClassId])
}
