{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XMI Package Parser Detailed Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "totalPackages",
    "totalElements",
    "totalAttributes",
    "totalLinks",
    "rootPackages"
  ],
  "properties": {
    "totalPackages": {
      "type": "integer",
      "minimum": 0
    },
    "totalElements": {
      "type": "integer",
      "minimum": 0
    },
    "totalAttributes": {
      "type": "integer",
      "minimum": 0
    },
    "totalLinks": {
      "type": "integer",
      "minimum": 0
    },
    "rootPackages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "associationLinkEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkEndId",
        "linkEndName",
        "linkEndClassId",
        "linkEndClassName",
        "multiplicity",
        "documentation",
        "stereotype"
      ],
      "properties": {
        "linkEndId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkEndName": {
          "type": "string"
        },
        "linkEndClassId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkEndClassName": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplicity": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "stereotype": {
          "type": "string"
        }
      }
    },
    "associacionListEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkId",
        "linkType",
        "documentation",
        "stereotype",
        "linkEnd"
      ],
      "properties": {
        "linkId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkType": {
          "type": "string",
          "enum": [
            "Association"
          ]
        },
        "documentation": {
          "type": "string"
        },
        "stereotype": {
          "type": "string"
        },
        "linkEnd": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/associationLinkEnd"
          }
        }
      }
    },
    "generalizationsListEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkId",
        "linkType",
        "documentation",
        "stereotype",
        "parent",
        "child"
      ],
      "properties": {
        "linkId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkType": {
          "type": "string",
          "enum": [
            "Generalization"
          ]
        },
        "documentation": {
          "type": "string"
        },
        "stereotype": {
          "type": "string"
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classId",
            "className"
          ],
          "properties": {
            "classId": {
              "type": [
                "string",
                "null"
              ]
            },
            "className": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "child": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classId",
            "className"
          ],
          "properties": {
            "classId": {
              "type": [
                "string",
                "null"
              ]
            },
            "className": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "description",
        "elementCount",
        "elements",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "elementCount": {
          "type": "integer",
          "minimum": 0
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "generalizationsList": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generalizationsListEntry"
          }
        },
        "associacionList": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/associacionListEntry"
          }
        }
      }
    },
    "enumLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "description",
        "initialValue"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "initialValue": {
          "type": "string"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "stereotype",
        "description",
        "visibility",
        "isAbstract",
        "attributeCount",
        "linkCount",
        "attributes",
        "links",
        "literals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "stereotype": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": "string"
        },
        "isAbstract": {
          "type": "boolean"
        },
        "attributeCount": {
          "type": "integer",
          "minimum": 0
        },
        "linkCount": {
          "type": "integer",
          "minimum": 0
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "literals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enumLiteral"
          }
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "type",
        "stereotype",
        "description",
        "multiplicity",
        "visibility",
        "initialValue"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "stereotype": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplicity": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "initialValue": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkId",
        "relationKind",
        "role",
        "targetClassId",
        "targetClassName",
        "targetClassRoleName",
        "srcClassRoleName",
        "targetDescription",
        "multiplicity"
      ],
      "properties": {
        "linkId": {
          "type": [
            "string",
            "null"
          ]
        },
        "relationKind": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "targetClassId": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetClassName": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetClassRoleName": {
          "type": [
            "string",
            "null"
          ]
        },
        "srcClassRoleName": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetDescription": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplicity": {
          "type": "string"
        }
      }
    }
  }
}