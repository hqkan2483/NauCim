{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XMI Package Parser Detailed Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "totalPackages",
    "totalElements",
    "totalAttributes",
    "totalLinks",
    "rootPackages"
  ],
  "properties": {
    "totalPackages": {
      "type": "integer",
      "minimum": 0
    },
    "totalElements": {
      "type": "integer",
      "minimum": 0
    },
    "totalAttributes": {
      "type": "integer",
      "minimum": 0
    },
    "totalLinks": {
      "type": "integer",
      "minimum": 0
    },
    "rootPackages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "associationLinkEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_end_id",
        "link_end_name",
        "link_end_class_id",
        "link_end_class_name",
        "multiplicity",
        "documentation",
        "stereotype"
      ],
      "properties": {
        "link_end_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "link_end_name": {
          "type": "string"
        },
        "link_end_class_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "link_end_class_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplicity": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "stereotype": {
          "type": "string"
        }
      }
    },
    "associacionListEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "link_type",
        "documentation",
        "stereotype",
        "linkEnd"
      ],
      "properties": {
        "link_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "link_type": {
          "type": "string",
          "enum": [
            "Association"
          ]
        },
        "documentation": {
          "type": "string"
        },
        "stereotype": {
          "type": "string"
        },
        "linkEnd": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/associationLinkEnd"
          }
        }
      }
    },
    "generalizationsListEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "link_type",
        "documentation",
        "stereotype",
        "parent",
        "child"
      ],
      "properties": {
        "link_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "link_type": {
          "type": "string",
          "enum": [
            "Generalization"
          ]
        },
        "documentation": {
          "type": "string"
        },
        "stereotype": {
          "type": "string"
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class_id",
            "class_name"
          ],
          "properties": {
            "class_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "class_name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "child": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class_id",
            "class_name"
          ],
          "properties": {
            "class_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "class_name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "description",
        "elementCount",
        "elements",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "elementCount": {
          "type": "integer",
          "minimum": 0
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "generalizations_list": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generalizationsListEntry"
          }
        },
        "associacion_list": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/associacionListEntry"
          }
        }
      }
    },
    "enumLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "description",
        "initial_value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "initial_value": {
          "type": "string"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "stereotype",
        "description",
        "visibility",
        "isAbstract",
        "attributeCount",
        "linkCount",
        "attributes",
        "links",
        "literals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "stereotype": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": "string"
        },
        "isAbstract": {
          "type": "boolean"
        },
        "attributeCount": {
          "type": "integer",
          "minimum": 0
        },
        "linkCount": {
          "type": "integer",
          "minimum": 0
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "literals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enumLiteral"
          }
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "type",
        "stereotype",
        "description",
        "multiplicity",
        "visibility",
        "initial_value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "stereotype": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplicity": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "initial_value": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "relation_kind",
        "role",
        "target_class_id",
        "target_class_name",
        "target_class_role_name",
        "src_class_role_name",
        "target_description",
        "multiplicity"
      ],
      "properties": {
        "link_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation_kind": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "target_class_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_class_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_class_role_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "src_class_role_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplicity": {
          "type": "string"
        }
      }
    }
  }
}