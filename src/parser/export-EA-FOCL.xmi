			<element xmi:idref="EAPK_B3AA2C60_B46E_42bd_BFA1_D2B0EB77D49D" xmi:type="uml:Package" name="Dynamics" scope="public">
				<model package2="EAID_B3AA2C60_B46E_42bd_BFA1_D2B0EB77D49D" package="EAPK_566B73D4_ED02_4d03_B450_704BD1F935D5" tpos="0" ea_localid="31" ea_eleType="package"/>
				<properties documentation="Пакет описывает наиболее общие модели из номенклатуры IEEE и (в случае ветрогенерации) МЭК, а также  модели, заложенные в ПО, используемое компаниями для исследования динамических энергосистем с позиций устойчивости.&#xA;Эти модели призваны обеспечить функциональную совместимость программного обеспечения разных разработчиков, применяемых энергокомпаниями (электросетевыми, энергоснабжающими, диспетчерскими). Важно отметить, что каждый производитель программного обеспечения волен по-своему внутренне реализовывать ту или иную модель. Допустимо обусловленное этим некоторое отличие результатов моделирования." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="zhilenkov-aa" version="1.0" phase="1.0" created="2022-06-14 14:04:18" modified="2022-06-14 14:05:12" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="IEC61970"/>
				<packageproperties version="1.0"/>
				<paths/>
				<times created="2022-06-14 14:04:17" modified="2022-06-14 14:05:12" lastloaddate="2025-05-28 14:54:30" lastsavedate="2025-05-28 14:54:30"/>
				<flags iscontrolled="FALSE" isprotected="FALSE" batchsave="0" batchload="0" usedtd="FALSE" logxml="FALSE"/>
			</element>
			<element xmi:idref="EAPK_4ACAE5DA_46EC_4985_ABB7_5A5FFE74A402" xmi:type="uml:Package" name="StandardModels" scope="public">
				<model package2="EAID_4ACAE5DA_46EC_4985_ABB7_5A5FFE74A402" package="EAPK_B3AA2C60_B46E_42bd_BFA1_D2B0EB77D49D" tpos="0" ea_localid="32" ea_eleType="package"/>
				<properties documentation="Этот подраздел содержит стандартные спецификации динамической модели, сгруппированные в пакеты по стандартному функциональному блоку (типу моделируемого оборудования).&#xA;В CIM стандартные динамические модели выражаются с помощью класса с именем стандартной модели и атрибутами, отражающими каждый из параметров, необходимых для описания поведения экземпляра стандартной модели." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="zhilenkov-aa" version="1.0" phase="1.0" created="2022-06-14 14:05:37" modified="2022-06-14 14:06:47" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
