			<element xmi:idref="EAPK_3164D9B9_BE74_48fe_8EAC_AE8B5BF1F0C2" xmi:type="uml:Package" name="SynchronousMachineDynamics" scope="public">
				<model package2="EAID_3164D9B9_BE74_48fe_8EAC_AE8B5BF1F0C2" package="EAPK_4ACAE5DA_46EC_4985_ABB7_5A5FFE74A402" tpos="0" ea_localid="33" ea_eleType="package"/>
				<properties documentation="Для обычных энергоблоков (например, тепловых, гидроагрегатов, турбин внутреннего сгорания) модель синхронной машины представляет электрические характеристики генератора и механические характеристики инерции вращения турбогенератора.  Большие промышленные двигатели или группы аналогичных двигателей могут быть представлены отдельными моделями двигателей, которые представлены как генераторы с отрицательной активной мощностью в статических данных (поток мощности).  &#xA;Взаимосвязь с уравнениями электрической сети может отличаться в зависимости от инструментов моделирования.  Инструменту достаточно знать синхронную машину, чтобы установить правильное соединение.  Взаимосвязь с оборудованием двигателя также может отличаться из-за входных и выходных сигналов, требуемых стандартными моделями." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="zhilenkov-aa" version="1.0" phase="1.0" created="2022-06-14 15:56:32" modified="2022-06-14 16:02:16" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="StandardModels"/>
