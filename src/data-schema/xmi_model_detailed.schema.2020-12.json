{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XMI Package Parser Detailed Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "totalPackages",
    "totalElements",
    "totalAttributes",
    "totalLinks",
    "packages"
  ],
  "properties": {
    "totalPackages": {
      "type": "integer",
      "minimum": 0
    },
    "totalElements": {
      "type": "integer",
      "minimum": 0
    },
    "totalAttributes": {
      "type": "integer",
      "minimum": 0
    },
    "totalLinks": {
      "type": "integer",
      "minimum": 0
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "associationLinkEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkEndId",
        "linkEndName",
        "linkEndClassId",
        "multiplicity",
        "documentation",
        "documentationRu",
        "details",
        "stereotype"
      ],
      "properties": {
        "linkEndId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkEndName": {
          "type": "string"
        },
        "linkEndClassId": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplicity": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "documentationRu": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "stereotype": {
          "type": "string"
        }
      }
    },
    "associationListEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkId",
        "linkType",
        "documentation",
        "documentationRu",
        "details",
        "stereotype",
        "linkEnd"
      ],
      "properties": {
        "linkId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkType": {
          "type": "string",
          "enum": [
            "Association"
          ]
        },
        "documentation": {
          "type": "string"
        },
        "documentationRu": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "stereotype": {
          "type": "string"
        },
        "linkEnd": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/associationLinkEnd"
          }
        }
      }
    },
    "generalizationsListEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkId",
        "linkType",
        "documentation",
        "documentationRu",
        "details",
        "stereotype",
        "parent",
        "child"
      ],
      "properties": {
        "linkId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkType": {
          "type": "string",
          "enum": [
            "Generalization"
          ]
        },
        "documentation": {
          "type": "string"
        },
        "documentationRu": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "stereotype": {
          "type": "string"
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classId"
          ],
          "properties": {
            "classId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "child": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classId"
          ],
          "properties": {
            "classId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "documentation",
        "documentationRu",
        "details",
        "elementCount",
        "classes",
        "subPackages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "documentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentationRu": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
         "type": [
          "string",
          "null"
        ]
        },
        "elementCount": {
          "type": "integer",
          "minimum": 0
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/class"
          }
        },
        "subPackages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "generalizationsList": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generalizationsListEntry"
          }
        },
        "associationList": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/associationListEntry"
          }
        }
      }
    },
    "enumLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "documentation",
        "initialValue"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentation": {
          "type": "string"
        },
        "initialValue": {
          "type": "string"
        }
      }
    },

    "profileRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "profileItemId"
      ],
      "properties": {
        "profileId": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileItemId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "stereotype",
        "documentation",
        "documentationRu",
        "details",
        "isAbstract",
        "attributes",
        "literals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "stereotype": {
          "type": "string"
        },
        "documentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentationRu": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "isAbstract": {
          "type": "boolean"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "literals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enumLiteral"
          }
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "dataTypeId",
        "stereotype",
        "documentation",
        "documentationRu",
        "details",
        "multiplicity",
        "initialValue"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataTypeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "stereotype": {
          "type": "string"
        },
        "documentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentationRu": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplicity": {
          "type": "string"
        },
        "initialValue": {
          "type": "string"
        }
      }
    }
    
  }
}